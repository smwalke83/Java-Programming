<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0"
            prefWidth="800.0"
            style="
            -fx-background-color: linear-gradient(to bottom, #0a5c2c, #063d1c);
            -fx-border-color: #4a2e1b;
            -fx-border-width: 10px;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cis2235.BragController">
    <children>

        <!-- Rules Box (Top) -->
        <TextArea fx:id="rulesDisplay"
                  editable="false"
                  layoutX="20.0"
                  layoutY="20.0"
                  prefHeight="100.0"
                  prefWidth="760.0"
                  style="
                  -fx-border-color: black;
                  -fx-border-width: 3px;
                  -fx-border-radius: 3px;
                  -fx-background-radius: 3px;"
                  wrapText="true"/>

        <!-- Control Row 1: Deal Hand, Winner Label, Determine Winner -->
        <Button fx:id="dealButton"
                layoutX="140.0"
                layoutY="140.0"
                mnemonicParsing="false"
                onAction="#handleDealButtonAction"
                prefHeight="35.0"
                prefWidth="130.0"
                text="Deal Hand"/>

        <!-- Scott can update this fx:id with "Player 1 Wins!", "Player 2 Wins!", or "It's a Tie!" -->
        <Label fx:id="winnerDisplay"
               alignment="CENTER"
               layoutX="280.0"
               layoutY="143.0"
               prefWidth="240.0"
               style="
               -fx-text-fill: white;
               -fx-font-weight: bold;
               -fx-font-size: 20px;"/>

        <Button fx:id="winnerButton"
                layoutX="530.0"
                layoutY="140.0"
                mnemonicParsing="false"
                onAction="#handleWinnerButtonAction"
                prefHeight="35.0"
                prefWidth="140.0"
                text="Determine Winner"/>

        <!-- Player 1 Cards (Left Side) -->
        <HBox layoutX="20.0" layoutY="200.0" spacing="8.0">
            <children>
                <ImageView fx:id="player1Card1" fitHeight="150.0" fitWidth="105.0" pickOnBounds="true"
                           preserveRatio="true" style="-fx-background-color: #cccccc;"/>
                <ImageView fx:id="player1Card2" fitHeight="150.0" fitWidth="105.0" pickOnBounds="true"
                           preserveRatio="true" style="-fx-background-color: #cccccc;"/>
                <ImageView fx:id="player1Card3" fitHeight="150.0" fitWidth="105.0" pickOnBounds="true"
                           preserveRatio="true" style="-fx-background-color: #cccccc;"/>
            </children>
        </HBox>

        <!-- Player 2 Cards (Right Side) -->
        <HBox layoutX="450.0" layoutY="200.0" spacing="8.0">
            <children>
                <ImageView fx:id="player2Card1" fitHeight="150.0" fitWidth="105.0" pickOnBounds="true"
                           preserveRatio="true" style="-fx-background-color: #cccccc;"/>
                <ImageView fx:id="player2Card2" fitHeight="150.0" fitWidth="105.0" pickOnBounds="true"
                           preserveRatio="true" style="-fx-background-color: #cccccc;"/>
                <ImageView fx:id="player2Card3" fitHeight="150.0" fitWidth="105.0" pickOnBounds="true"
                           preserveRatio="true" style="-fx-background-color: #cccccc;"/>
            </children>
        </HBox>

        <!-- Player 1 Name Input -->
        <TextField fx:id="player1NameInput"
                   layoutX="100.0"
                   layoutY="370.0"
                   prefWidth="170.0"
                   promptText="Enter Player 1 Name"
                   style="
                   -fx-border-color: black;
                   -fx-border-width: 2px;
                   -fx-border-radius: 3px;
                   -fx-background-radius: 3px;"/>

        <!-- Play Again Button (Centered Between Inputs) -->
        <Button fx:id="resetButton"
                layoutX="345.0"
                layoutY="410.0"
                mnemonicParsing="false"
                onAction="#handlePlayAgainButtonAction"
                prefHeight="35.0"
                prefWidth="110.0"
                text="Play Again"/>

        <!-- Player 2 Name Input -->
        <TextField fx:id="player2NameInput"
                   layoutX="530.0"
                   layoutY="370.0"
                   prefWidth="170.0"
                   promptText="Enter Player 2 Name"
                   style="
                   -fx-border-color: black;
                   -fx-border-width: 2px;
                   -fx-border-radius: 3px;
                   -fx-background-radius: 3px;"/>

        <!-- Status / Points Tracker Footer -->
        <Label fx:id="statusText"
               alignment="CENTER"
               layoutX="20.0"
               layoutY="455.0"
               prefWidth="760.0"
               style="-fx-text-fill: white; -fx-font-weight: bold;"
               text="Enter names and press Deal to begin!">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>

    </children>
</AnchorPane>
