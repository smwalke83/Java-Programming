<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cis2235.walkerp8.HelloController">
    <children>
        <TextField fx:id="tfMessageInput" layoutX="122.0" layoutY="389.0" prefHeight="25.0" prefWidth="366.0" promptText="Enter message to be encoded" />
        <RadioButton fx:id="rbFixedKey" layoutX="13.0" layoutY="242.0" mnemonicParsing="false" selected="true" text="Enter a key (1-50)">
            <toggleGroup>
                <ToggleGroup fx:id="radioGroup1" />
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbGeneratedKey" layoutX="13.0" layoutY="210.0" mnemonicParsing="false" text="Generated Key" toggleGroup="$radioGroup1" />
        <TextField fx:id="tfKeyInput" layoutX="14.0" layoutY="272.0" promptText="Enter Key" />
        <MenuBar prefHeight="25.0" prefWidth="500.0">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#onOpenClick" text="Open File" />
                        <MenuItem mnemonicParsing="false" onAction="#onSaveClick" text="Save File" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="About">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#onAboutClick" text="About Enigma" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <Button fx:id="btnEncode" layoutX="207.0" layoutY="272.0" mnemonicParsing="false" onMouseClicked="#onEncodeClick" text="Encode" />
        <Button fx:id="btnDecode" layoutX="294.0" layoutY="272.0" mnemonicParsing="false" onMouseClicked="#onDecodeClick" text="Decode" />
        <Label alignment="CENTER" layoutX="1.0" layoutY="37.0" prefHeight="27.0" prefWidth="500.0" text="Welcome to the Enigma Encoding/Decoding Machine!" textAlignment="CENTER">
            <font>
                <Font name="System Bold Italic" size="18.0" />
            </font>
        </Label>
        <TextArea editable="false" layoutX="13.0" layoutY="85.0" prefHeight="110.0" prefWidth="200.0" text="To Encode, enter your message below. Select enter a key or have one generated, choose the Enigma type, then press Encode. Select File &gt; Save File to save your message to a file." wrapText="true" />
        <TextArea editable="false" layoutX="286.0" layoutY="85.0" prefHeight="110.0" prefWidth="200.0" text="To Decode, select File &gt; Open File, then browse to a file with a coded message. Then, press the Decode button." wrapText="true" />
        <Button fx:id="btnClear" layoutX="386.0" layoutY="272.0" mnemonicParsing="false" onMouseClicked="#onClearClick" text="Clear" />
        <Label layoutX="14.0" layoutY="393.0" text="Message:" />
        <Label layoutX="13.0" layoutY="426.0" text="Coded Message:" />
        <TextField fx:id="tfCodedMessage" editable="false" layoutX="122.0" layoutY="422.0" prefHeight="25.0" prefWidth="366.0" />
        <Label layoutX="13.0" layoutY="458.0" text="Key:" />
        <TextField fx:id="tfKey" editable="false" layoutX="122.0" layoutY="454.0" prefHeight="25.0" prefWidth="366.0" />
        <Label fx:id="lblError" alignment="CENTER" layoutY="219.0" prefHeight="17.0" prefWidth="500.0" textAlignment="CENTER" textFill="RED" />
        <Label alignment="CENTER" layoutY="64.0" prefHeight="17.0" prefWidth="500.0" text="Scott Walker - Program 8" textAlignment="CENTER" />
      <RadioButton fx:id="rbGEnigma" layoutX="65.0" layoutY="351.0" mnemonicParsing="false" selected="true" text="G Enigma">
         <toggleGroup>
            <ToggleGroup fx:id="radioGroup2" />
         </toggleGroup>
      </RadioButton>
      <RadioButton fx:id="rbPrimesEnigma" layoutX="204.0" layoutY="351.0" mnemonicParsing="false" text="Primes Enigma" toggleGroup="$radioGroup2" />
      <RadioButton fx:id="rbTexasEnigma" layoutX="351.0" layoutY="351.0" mnemonicParsing="false" text="Texas Enigma" toggleGroup="$radioGroup2" />
      <Label alignment="CENTER" layoutX="197.0" layoutY="318.0" text="Select Enigma Type:" textAlignment="CENTER" />
    </children>
</AnchorPane>
